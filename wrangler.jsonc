{
  "name": "troyco-space",
  "compatibility_date": "2026-07-29",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Private visitor stats (see worker/stats.js). No database ID on purpose:
  // Cloudflare creates this database the first time the site deploys.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "troyco-stats"
    }
  ]
}
