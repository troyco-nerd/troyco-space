---
import { SITE_TITLE, NAV_LINKS } from '../consts';

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>
      <img
        src="/logo-lockup.webp"
        alt="troyco.space"
        width="760"
        height="245"
        class="brand-logo"
      />
    </a>
    <nav>
      <ul class="nav-links">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={pathname === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
