---
import { SITE_TITLE, NAV_LINKS } from '../consts';

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand">{SITE_TITLE}</a>
    <nav>
      <ul class="nav-links">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={pathname === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
