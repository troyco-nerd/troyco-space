---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getTagIndex } from '../../utils/tags';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Only tags that are on at least one published post.
const tags = (await getTagIndex()).filter((tag) => tag.posts.length > 0);
---

<Layout title="Blog" description="Posts about what I'm building and learning.">
  <main class="page narrow">
    <h1>Blog</h1>
    {tags.length > 0 && (
      <nav class="tag-browse" aria-label="Browse posts by tag">
        <ul class="tag-list">
          {tags.map((tag) => (
            <li>
              <a class="tag" href={`/tags/${tag.slug}/`}>
                {tag.label} <span class="count">{tag.posts.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {posts.length === 0 ? (
      <p class="entry-desc">Nothing published yet — check back soon.</p>
    ) : (
      <ul class="entry-list">
        {posts.map((post) => (
          <EntryCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            date={post.data.pubDate}
            description={post.data.description}
            tags={post.data.tags}
            image={post.data.image}
          />
        ))}
      </ul>
    )}
  </main>
</Layout>
