---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../utils/formatDate';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog" description="Posts about what I'm building and learning.">
  <main class="page narrow">
    <h1>Blog</h1>
    {posts.length === 0 ? (
      <p class="entry-desc">Nothing published yet — check back soon.</p>
    ) : (
      <ul class="entry-list">
        {posts.map((post) => (
          <li>
            <h2 class="entry-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="entry-meta">{formatDate(post.data.pubDate)}</p>
            <p class="entry-desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list">
                {post.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
